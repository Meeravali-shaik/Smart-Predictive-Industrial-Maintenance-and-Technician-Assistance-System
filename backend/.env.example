APP_NAME=Industrial Maintenance System
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./industrial_maintenance.db
